       "raw": "{\n \"email\": \"admin@torque.test\",\n \"password\": \"Torque@2026\"\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.collectionVariables.set('token', pm.response.json().token);"
